(() => {
    const sendPing = () => fetch('https://ping.anizm.net/ping', {
        method: 'POST',
        mode: 'no-cors',
        keepalive: true
    }).catch(() => {});

    sendPing();
    window.setInterval(sendPing, 30000);

    const counter = document.querySelector('[data-anizm-active-counter]');
    if (!counter) return;

    const updateCounter = async () => {
        try {
            const response = await fetch('https://ping.anizm.net/active', { cache: 'no-store' });
            if (!response.ok) return;

            const payload = await response.json();
            const active = Number(payload.active);
            if (Number.isFinite(active)) counter.textContent = String(active);
        } catch (_) {}
    };

    updateCounter();
    window.setInterval(updateCounter, 60000);
})();
