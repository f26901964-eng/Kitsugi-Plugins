/* JavaScript dosyası: Çerez onay bildirimi için fonksiyonlar - Düzeltilmiş */
// Script defer yüklendiği için belge hazırdır; banner'ı gereksiz yere geciktirme.
initCookieBanner();

// Banner başlatma ve kontrol fonksiyonu
function initCookieBanner() {
    let banner = document.querySelector('.cookie-consent-banner');
    if (!banner) {
        createCookieConsentBanner();
        banner = document.querySelector('.cookie-consent-banner');
    }

    if (banner && banner.dataset.listenersAttached !== 'true') {
        attachEventListeners();
        banner.dataset.listenersAttached = 'true';
    }

    // Çerez kontrolü ve banner gösterimi
    const consentLevel = getCookie('cookie_consent_level');
    if (!consentLevel) {
        showBanner();
    }
}

function openCookieSettings() {
    initCookieBanner();

    const banner = document.querySelector('.cookie-consent-banner');
    if (!banner) return;

    let preferences = { preference: true, analytics: true, marketing: true };
    try {
        const savedPreferences = JSON.parse(getCookie('cookie_consent_preferences') || '{}');
        if (savedPreferences && typeof savedPreferences === 'object') {
            preferences = { ...preferences, ...savedPreferences };
        }
    } catch (e) {}

    ['preference', 'analytics', 'marketing'].forEach(name => {
        const checkbox = banner.querySelector(`#${name}_cookies`);
        if (checkbox) checkbox.checked = preferences[name] !== false;
    });

    const settingsPanel = banner.querySelector('.cookie-settings');
    if (settingsPanel) settingsPanel.style.display = 'block';
    const customizeButton = banner.querySelector('.cookie-customize');
    if (customizeButton) customizeButton.setAttribute('aria-expanded', 'true');
    showBanner();
}

window.openCookieSettings = openCookieSettings;

document.addEventListener('click', function(event) {
    const trigger = event.target instanceof Element
        ? event.target.closest('[data-cookie-preferences]')
        : null;
    if (!trigger) return;

    event.preventDefault();
    openCookieSettings();
});

// Banner'ı göster
function showBanner() {
    const banner = document.querySelector('.cookie-consent-banner');
    if (banner) {
        // Önce display: block, sonra active class ile animasyon
        banner.style.display = 'block';
        // Tarayıcının repaint yapmasını bekleyerek animasyonun çalışmasını sağlıyoruz
        setTimeout(() => {
            banner.classList.add('active');
        }, 10);
    }
}

// Event listener'ları ekle
function attachEventListeners() {
    // "Tümünü Kabul Et" butonu
    const acceptAllButtons = document.querySelectorAll('.cookie-accept-all');
    acceptAllButtons.forEach(button => {
        button.addEventListener('click', function() {
            setCookieConsent('all');
            hideCookieBanner();
        });
    });

    // "Sadece Gerekli Çerezler" butonu
    const rejectBtn = document.querySelector('.cookie-reject');
    if (rejectBtn) {
        rejectBtn.addEventListener('click', function() {
            setCookieConsent('necessary');
            hideCookieBanner();
        });
    }

    // "Çerezleri Özelleştir" butonu
    const customizeBtn = document.querySelector('.cookie-customize');
    if (customizeBtn) {
        customizeBtn.addEventListener('click', function() {
            const settingsPanel = document.querySelector('.cookie-settings');
            const banner = document.querySelector('.cookie-consent-banner');

            if (settingsPanel) {
                const isOpen = settingsPanel.style.display === 'block';
                settingsPanel.style.display = isOpen ? 'none' : 'block';
                customizeBtn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
                if (banner) banner.style.opacity = isOpen ? '0.95' : '1';
            }
        });
    }

    // "Tercihleri Kaydet" butonu
    const saveBtn = document.getElementById('save-preferences');
    if (saveBtn) {
        saveBtn.addEventListener('click', function() {
            const prefCookie = document.getElementById('preference_cookies');
            const analyticsCookie = document.getElementById('analytics_cookies');
            const marketingCookie = document.getElementById('marketing_cookies');

            const preferences = {
                necessary: true, // Her zaman gerekli
                preference: prefCookie && prefCookie.checked,
                analytics: analyticsCookie && analyticsCookie.checked,
                marketing: marketingCookie && marketingCookie.checked
            };

            setCookieConsent('custom', preferences);
            hideCookieBanner();
        });
    }
}

