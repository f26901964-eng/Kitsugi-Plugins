// Çerez bildirimini gizle
function hideCookieBanner() {
    const banner = document.querySelector('.cookie-consent-banner');
    if (banner) {
        banner.classList.remove('active');
        // Animasyon için biraz bekle
        setTimeout(function() {
            banner.style.display = 'none';
        }, 300);
    }
}

// Çerez tercihlerini kaydet
function setCookieConsent(level, preferences = null) {
    try {
        if (level === 'all') {
            setCookie('cookie_consent_level', 'all', 365);
            setCookie('cookie_consent_preferences', JSON.stringify({
                necessary: true,
                preference: true,
                analytics: true,
                marketing: true
            }), 365);

        } else if (level === 'necessary') {
            setCookie('cookie_consent_level', 'necessary', 365);
            setCookie('cookie_consent_preferences', JSON.stringify({
                necessary: true,
                preference: false,
                analytics: false,
                marketing: false
            }), 365);

        } else if (level === 'custom' && preferences) {
            setCookie('cookie_consent_level', 'custom', 365);
            setCookie('cookie_consent_preferences', JSON.stringify(preferences), 365);

        }

        // Başarılı mı kontrol et
        const savedLevel = getCookie('cookie_consent_level');
        if (!savedLevel) {
            // Alternatif yöntem dene
            forceSetCookie('cookie_consent_level', level);
            return false;
        }
        return true;
    } catch (e) {
        return false;
    }
}

// Çerez oluştur - koruma sistemi düzeltilmiş sürüm
function setCookie(name, value, days) {
    try {
        // Özel çerezleri koruma - popundr/popundr1 çerezlerini değiştirmeyelim
        const protectedCookies = ['popundr', 'popundr1', 'popupunder', 'popupunder1', 'poundr1'];
        const isProtected = protectedCookies.includes(name);

        if (isProtected) {
            // Korumalı çerezler için varsayılan süre (2 saat)
            const twoHoursInMs = 2 * 60 * 60 * 1000; // 7,200,000 ms
            const date = new Date();
            date.setTime(date.getTime() + twoHoursInMs);
            const expires = "; expires=" + date.toUTCString();

            // Korumalı çerezler için 2 saatlik süre ile kaydet
            const cookieValue = name + "=" + encodeURIComponent(value || "") + expires + "; path=/;";
            document.cookie = cookieValue;

            // Kontrolünü yap
            setTimeout(() => {
                const savedValue = getCookie(name);
                if (!savedValue) {
                    document.cookie = cookieValue;
                }
            }, 100);

            return true;
        }

        // Normal çerezler için standart işlem
        let expires = "";
        if (days) {
            // Günü saniyeye çevir, sonra milisaniyeye
            const maxDays = 30; // Maksimum 30 gün
            const safeDays = Math.min(days, maxDays);
            const seconds = safeDays * 24 * 60 * 60;
            const milliseconds = seconds * 1000;

            const date = new Date();
            date.setTime(date.getTime() + milliseconds);

            // toUTCString ile en güvenilir şekilde tarih formatı
            expires = "; expires=" + date.toUTCString();
        }

        // Cookie değerini oluştur
        const cookieValue = name + "=" + encodeURIComponent(value || "") + expires + "; path=/;";
        document.cookie = cookieValue;

        // Cookie'nin başarıyla ayarlanıp ayarlanmadığını kontrol et
        setTimeout(() => {
            const savedValue = getCookie(name);
            if (!savedValue) {
                // Başarısız olursa tekrar dene - yedek strateji
                document.cookie = cookieValue;
            }
        }, 100);

        return true;
    } catch (e) {
        return false;
    }
}

// Alternatif çerez oluşturma yöntemi
function forceSetCookie(name, value) {
    try {
        // En basit form
        document.cookie = name + "=" + encodeURIComponent(value || "");

        // Bir de bu şekilde deneyelim
        document.cookie = name + "=" + encodeURIComponent(value || "") + "; path=/;";

        // LocalStorage'a da yedek olarak kaydet
        try {
            localStorage.setItem('cookie_backup_' + name, value);
        } catch(e) {}

        return true;
    } catch(e) {
        return false;
    }
}

// Çerez değerini oku - iyileştirilmiş
function getCookie(name) {
    try {
        // Normal yöntem
        const nameEQ = name + "=";
        const ca = document.cookie.split(';');
        for (let i = 0; i < ca.length; i++) {
            let c = ca[i];
            while (c.charAt(0) === ' ') c = c.substring(1, c.length);
            if (c.indexOf(nameEQ) === 0) {
                const value = decodeURIComponent(c.substring(nameEQ.length, c.length));
                return value;
            }
        }

        // LocalStorage'dan backup kontrolü
        try {
            const backupValue = localStorage.getItem('cookie_backup_' + name);
            if (backupValue) {
                return backupValue;
            }
        } catch(e) {}

        return null;
    } catch(e) {
        return null;
    }
}
